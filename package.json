    "ffmpeg-static": "^5.2.0",
    "next": "16.2.12",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "three": "0.179.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
