{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts",
    ".next-canvas-qa/types/**/*.ts",
    ".next-canvas-qa/dev/types/**/*.ts",
    ".next-minimax-voice-qa/types/**/*.ts",
    ".next-minimax-voice-qa/dev/types/**/*.ts",
    ".next-agent-qa/types/**/*.ts",
    ".next-agent-qa/dev/types/**/*.ts",
    ".next-agent-workspace-verify2-20261126/types/**/*.ts",
    ".next-agent-workspace-verify2-20261126/dev/types/**/*.ts",
    ".next-agent-workspace-final-20261126/types/**/*.ts",
    ".next-agent-workspace-final-20261126/dev/types/**/*.ts",
    ".next-agent-workspace-budget-20261126/types/**/*.ts",
    ".next-agent-workspace-budget-20261126/dev/types/**/*.ts",
    ".next-agent-workspace-ui-20261126/types/**/*.ts",
    ".next-agent-workspace-ui-20261126/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev/types"
  ]
}
