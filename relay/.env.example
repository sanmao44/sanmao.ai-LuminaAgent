# The DNS A/AAAA record for this domain must point to the server running Docker.
SANMAO_RELAY_DOMAIN=media.example.com

# The public HTTPS origin that Agnes can fetch. Put the domain handled by your
# reverse proxy here, without a trailing slash.
SANMAO_RELAY_PUBLIC_BASE_URL=https://media.example.com

# Keep this secret on the relay server. Do not put it in the desktop app.
SANMAO_MASTER_KEY=replace-with-a-long-random-secret

# Optional shared upload token for private/self-hosted relay deployments.
# The project default public relay can leave this empty and rely on rate limits.
# SANMAO_MEDIA_RELAY_UPLOAD_TOKEN=replace-with-a-second-random-secret
